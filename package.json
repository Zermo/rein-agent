{
  "name": "rein-agent",
  "version": "0.4.0",
  "description": "A minimal, local-first agent harness. System prompt + tools + agentic loop + translation layer, with self-hosted local AI as the default provider.",
  "type": "module",
  "bin": {
    "rein-agent": "dist/rein.js",
    "rein": "dist/rein.js"
  },
  "files": [
    "dist",
    "bin",
    "src",
    "test",
    "vendor",
    "examples",
    "AGENTS.md",
    "GATES.md",
    "LESSONS.md",
    "REVIEW.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zermo/rein-agent.git"
  },
  "bugs": {
    "url": "https://github.com/Zermo/rein-agent/issues"
  },
  "homepage": "https://github.com/Zermo/rein-agent#readme",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/smoke.ts && node --test test/*.test.ts",
    "bundle": "node scripts/build.mjs",
    "check:posthorse": "node scripts/check-posthorse.mjs"
  },
  "keywords": [
    "agent",
    "harness",
    "llm",
    "ollama",
    "lmstudio",
    "local-ai",
    "coding-agent"
  ],
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
