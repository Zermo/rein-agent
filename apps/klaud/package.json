{
  "name": "@rein/klaud",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "productName": "Klaudbot",
  "main": "main.mjs",
  "license": "MIT",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "postinstall": "install-electron",
    "build": "node build.mjs",
