  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "esbuild": "0.28.2"
  },
  "build": { "appId": "org.zermo.rein-klaud", "productName": "Klaudbot", "icon": "icon.png" }
